{
  "schema": 1,
  "name": "mercato-crm-template",
  "description": "Open Mercato CRM starter app: companies, people, deals, pipelines and email channels on Open Mercato 0.9.",
  "openMercato": "0.9.x",
  "modules": [
    {
      "id": "auth",
      "from": "@open-mercato/core"
    },
    {
      "id": "api_keys",
      "from": "@open-mercato/core"
    },
    {
      "id": "directory",
      "from": "@open-mercato/core"
    },
    {
      "id": "configs",
      "from": "@open-mercato/core"
    },
    {
      "id": "entities",
      "from": "@open-mercato/core"
    },
    {
      "id": "query_index",
      "from": "@open-mercato/core"
    },
    {
      "id": "api_docs",
      "from": "@open-mercato/core"
    },
    {
      "id": "audit_logs",
      "from": "@open-mercato/core"
    },
    {
      "id": "notifications",
      "from": "@open-mercato/core"
    },
    {
      "id": "dashboards",
      "from": "@open-mercato/core"
    },
    {
      "id": "events",
      "from": "@open-mercato/events",
      "package": "@open-mercato/events@0.9.0"
    },
    {
      "id": "search",
      "from": "@open-mercato/search",
      "package": "@open-mercato/search@0.9.0"
    },
    {
      "id": "attachments",
      "from": "@open-mercato/core"
    },
    {
      "id": "customers",
      "from": "@open-mercato/core"
    },
    {
      "id": "messages",
      "from": "@open-mercato/core"
    },
    {
      "id": "dictionaries",
      "from": "@open-mercato/core"
    },
    {
      "id": "feature_toggles",
      "from": "@open-mercato/core"
    },
    {
      "id": "currencies",
      "from": "@open-mercato/core"
    },
    {
      "id": "progress",
      "from": "@open-mercato/core"
    },
    {
      "id": "integrations",
      "from": "@open-mercato/core"
    },
    {
      "id": "communication_channels",
      "from": "@open-mercato/core"
    },
    {
      "id": "channel_imap",
      "from": "@open-mercato/channel-imap",
      "package": "@open-mercato/channel-imap@0.9.0"
    },
    {
      "id": "channel_gmail",
      "from": "@open-mercato/channel-gmail",
      "package": "@open-mercato/channel-gmail@0.9.0"
    },
    {
      "id": "ai_assistant",
      "from": "@open-mercato/ai-assistant",
      "package": "@open-mercato/ai-assistant@0.9.0"
    },
    {
      "id": "record_locks",
      "from": "@open-mercato/enterprise",
      "package": "@open-mercato/enterprise@0.9.0",
      "when": "OM_ENABLE_ENTERPRISE_MODULES"
    },
    {
      "id": "system_status_overlays",
      "from": "@open-mercato/enterprise",
      "package": "@open-mercato/enterprise@0.9.0",
      "when": "OM_ENABLE_ENTERPRISE_MODULES"
    },
    {
      "id": "sso",
      "from": "@open-mercato/enterprise",
      "package": "@open-mercato/enterprise@0.9.0",
      "when": "OM_ENABLE_ENTERPRISE_MODULES && OM_ENABLE_ENTERPRISE_MODULES_SSO"
    },
    {
      "id": "security",
      "from": "@open-mercato/enterprise",
      "package": "@open-mercato/enterprise@0.9.0",
      "when": "OM_ENABLE_ENTERPRISE_MODULES && OM_ENABLE_ENTERPRISE_MODULES_SECURITY"
    },
    {
      "id": "agent_orchestrator",
      "from": "@open-mercato/enterprise",
      "package": "@open-mercato/enterprise@0.9.0",
      "when": "OM_ENABLE_ENTERPRISE_MODULES && OM_ENABLE_ENTERPRISE_MODULES_AGENTS"
    },
    {
      "id": "agent_examples",
      "from": "@app",
      "when": "OM_ENABLE_ENTERPRISE_MODULES && OM_ENABLE_ENTERPRISE_MODULES_AGENTS"
    }
  ],
  "createdWith": {
    "tool": "create-mercato-template",
    "version": "0.1.0"
  }
}
